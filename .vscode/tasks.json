{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Собрать проект",
			"type": "shell",
			"command": ".\\gradlew.bat build",
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Сгенерировать Javadoc",
			"type": "shell",
			"command": ".\\gradlew.bat javadoc",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Запустить тесты",
			"type": "shell",
			"command": ".\\gradlew.bat test",
			"problemMatcher": [],
			"group": {
				"kind": "test",
				"isDefault": true
			}
		},
		{
			"label": "Запустить проверки (check)",
			"type": "shell",
			"command": ".\\gradlew.bat check",
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Проверить лицензионные заголовки",
			"type": "shell",
			"command": ".\\gradlew.bat license",
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Запустить CLI (validate)",
			"type": "shell",
			"command": ".\\gradlew.bat run --args=\"validate -v V2_20 fixtures/ssl31/src/cf/Configuration.xml resources/namespace-forest\"",
			"problemMatcher": []
		},
		{
			"label": "Сгенерировать CHANGELOG",
			"type": "shell",
			"command": "git-cliff --config cliff.toml --output CHANGELOG.md",
			"problemMatcher": [],
			"group": "build"
		}
	]
}
